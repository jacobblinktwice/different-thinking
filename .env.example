# The site's public origin, used for the OG image URL, robots and the sitemap.
# Set this to the live domain at launch — it is the only thing that needs
# changing. Left unset, production falls back to the Vercel-assigned URL and
# previews describe themselves, so nothing points at a domain that does not
# resolve yet.
NEXT_PUBLIC_SITE_URL=

# Access code for /lab. Gates the write side of /api/composition, which fails
# closed without it. Never referenced from client code — server only.
LAB_KEY=

# Vercel Blob, for the shared live glitch composition. Either works; OIDC stores
# use BLOB_STORE_ID. Unset locally falls back to files under .data/.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
