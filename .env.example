# Access code for /lab. Gates the write side of /api/composition, which fails
# closed without it. Never referenced from client code — server only.
LAB_KEY=

# Vercel Blob, for the shared live glitch composition. Either works; OIDC stores
# use BLOB_STORE_ID. Unset locally falls back to files under .data/.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
